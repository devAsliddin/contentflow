# ─────────────────────────────────────────────────────────────────────────────
# ContentFlow — Environment Variables
# Copy this file to .env and fill in all required values.
#
# Generate SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Generate ENCRYPTION_KEY:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-32-char-random-hex-string
ENCRYPTION_KEY=change-this-to-a-fernet-base64-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=contentflow
POSTGRES_PASSWORD=change-this-strong-db-password
POSTGRES_DB=contentflow
DATABASE_URL=postgresql+asyncpg://contentflow:change-this-strong-db-password@postgres:5432/contentflow

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS — comma-separated list of allowed origins ───────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Media storage ─────────────────────────────────────────────────────────────
MEDIA_DIR=/app/media

# ── AI — Anthropic Claude ─────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-4-20250514

# ── V5 — AI Provider routing (free-first) ────────────────────────────────────
# Which provider handles each task type. Change only via .env — no code changes.
# Providers: groq | openrouter | vllm | ollama | anthropic
# No API keys at all? Use local Ollama for everything:
#   AI_ANALYSIS_PROVIDER=ollama, AI_CLASSIFICATION_PROVIDER=ollama,
#   AI_CONTENT_PROVIDER=ollama, AI_FALLBACK_CHAIN=ollama,openrouter,groq
AI_ANALYSIS_PROVIDER=groq
AI_CLASSIFICATION_PROVIDER=vllm
AI_CONTENT_PROVIDER=groq
AI_FALLBACK_CHAIN=groq,openrouter,vllm

# Groq (free tier) — get key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=5

# vLLM (self-hosted OpenAI-compatible endpoint)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen2.5-7B-Instruct

# V5 — Analysis settings
ANALYSIS_MEDIA_LIMIT=50
ANALYSIS_CLASSIFY_CHUNK_SIZE=10

# ── AI — Ollama (optional local LLM) ─────────────────────────────────────────
# Leave as default if running Ollama on the host machine
OLLAMA_URL=http://host.docker.internal:11434
# Model used when an AI_*_PROVIDER above is set to "ollama" (ollama pull qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:7b

# ── AI — OpenRouter (optional fallback) ──────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# ── Instagram / Facebook ──────────────────────────────────────────────────────
# Create an app at: https://developers.facebook.com
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── V4: Instagram auto-reply (DM + comment) ────────────────────────────────────
# Meta app credentials (fall back to INSTAGRAM_APP_ID/SECRET if left blank).
META_APP_ID=
META_APP_SECRET=
# Must EXACTLY match the redirect URI registered in the Meta app dashboard.
INSTAGRAM_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/accounts/instagram/oauth/callback
# Any secret string — must match the "Verify Token" entered in Meta → Webhooks.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Meta bumps the Graph version often — keep it configurable.
INSTAGRAM_GRAPH_VERSION=v23.0

# ── V6: Facebook OAuth + Webhooks ─────────────────────────────────────────────
# Uses FB_APP_ID / FB_APP_SECRET; falls back to META_APP_ID/SECRET if left blank.
FB_APP_ID=
FB_APP_SECRET=
# Must EXACTLY match the redirect URI registered in the Meta app dashboard.
FB_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/accounts/facebook/oauth/callback
FB_GRAPH_VERSION=v23.0
# Any secret string — must match "Verify Token" entered in Meta → Webhooks.
FB_WEBHOOK_VERIFY_TOKEN=

# ── V6: Image Generation ───────────────────────────────────────────────────────
# Primary provider and fallback chain (provider names: cloudflare, pollinations)
IMAGE_PROVIDER=cloudflare
IMAGE_FALLBACK_CHAIN=cloudflare,pollinations
# Cloudflare Workers AI — create API token at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Pollinations.ai — anonymous tier is now paywalled (402); register a FREE token
# at https://enter.pollinations.ai and paste it below to restore free access.
POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_API_TOKEN=
# Default image dimensions (WxH) for generated images
IMAGE_DEFAULT_SIZE=1024x1024
# Max image generation requests per user per hour (rate limit)
IMAGE_RATE_LIMIT_PER_USER_HOUR=10

# ── TikTok ────────────────────────────────────────────────────────────────────
# Create an app at: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── LinkedIn ─────────────────────────────────────────────────────────────────
# Create an app at: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── YouTube ──────────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── X (Twitter) ───────────────────────────────────────────────────────────────
# Create an app at: https://developer.twitter.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
