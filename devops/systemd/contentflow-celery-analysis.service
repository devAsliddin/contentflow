[Unit]
Description=ContentFlow Celery Analysis Worker (dedicated -Q analysis queue)
After=network.target redis.service postgresql.service
Wants=redis.service postgresql.service

[Service]
Type=exec
User=contentflow
Group=contentflow
WorkingDirectory=/var/www/contentflow/backend
EnvironmentFile=/etc/contentflow/.env
ExecStart=/var/www/contentflow/venv/bin/celery \
    -A app.tasks.celery_app worker \
    --loglevel=info \
    --concurrency=2 \
    --queues=analysis \
    --hostname=analysis@%h \
    --logfile=/var/log/contentflow/celery-analysis.log
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=contentflow-celery-analysis

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/www/contentflow/media /var/log/contentflow

[Install]
WantedBy=multi-user.target
